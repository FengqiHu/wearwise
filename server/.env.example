PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# OpenAI API configuration
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# Model selection (restart the server after changing these)
# Shared defaults. A blank module override inherits the corresponding default.
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_RECOMMENDATION_MODEL=

# Independent modules
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_HUMAN_PRESENCE_MODEL=
OPENAI_CLOTHING_PRESENCE_MODEL=
OPENAI_CLOTHING_EXTRACTION_MODEL=
OPENAI_STYLE_SUMMARY_MODEL=
OPENAI_OUTFIT_RECOMMENDATION_MODEL=
OPENAI_SHOP_RECOMMENDATION_MODEL=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Google OAuth 2.0 configuration
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_SECONDS=604800

# MongoDB configuration
MONGODB_URI= YOUR_MONGODB_URI_HERE
MONGODB_DB_NAME=wearwise
MONGODB_USERS_COLLECTION=users
MONGODB_CONVERSATIONS_COLLECTION=conversations

#Cloud Storage (S3-compatible) configuration
S3_BUCKET=wearwise
S3_ENDPOINT=YOUR_S3_ENDPOINT_HERE
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID_HERE
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY_HERE
S3_REGION=auto
S3_PUBLIC_BASE_URL=YOUR_S3_PUBLIC_BASE_URL_HERE

OPENWEATHER_API_KEY= YOUR_OPENWEATHER_API_KEY_HERE

UPLOAD_MODERATION_TIMEOUT_MS=10000
